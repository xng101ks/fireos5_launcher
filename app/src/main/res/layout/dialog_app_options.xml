<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header: App icon and name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_launcher" />

        <TextView
            android:id="@+id/dialog_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="App Name" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#22FFFFFF" />

    <!-- Action Buttons with Explicit D-pad Focus Chain -->
    <Button
        android:id="@+id/btn_action_open"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/dialog_item_selector"
        android:focusable="true"
        android:nextFocusDown="@+id/btn_action_favorite"
        android:text="@string/action_open"
        android:textAllCaps="false"
        android:textColor="@color/selector_dialog_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_action_favorite"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/dialog_item_selector"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_action_open"
        android:nextFocusDown="@+id/btn_action_info"
        android:text="@string/action_add_favorite"
        android:textAllCaps="false"
        android:textColor="@color/selector_dialog_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_action_info"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/dialog_item_selector"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_action_favorite"
        android:nextFocusDown="@+id/btn_action_uninstall"
        android:text="@string/action_app_info"
        android:textAllCaps="false"
        android:textColor="@color/selector_dialog_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_action_uninstall"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/dialog_item_selector"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_action_info"
        android:text="@string/action_uninstall"
        android:textAllCaps="false"
        android:textColor="@color/selector_dialog_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
